        "select", "pselect6", "sched_yield",
        "mremap", "msync", "madvise",
        "dup", "dup2", "dup3",
        "nanosleep", "clock_nanosleep",
        "getpid", "getppid", "getuid", "geteuid", "getgid", "getegid",
        "uname", "fcntl",
        "flock", "fsync", "fdatasync", "ftruncate",
        "getcwd", "chdir",
        "readlink", "readlinkat",
        "chmod", "fchmod", "fchmodat",
        "umask",
        "gettimeofday", "clock_gettime", "clock_getres",
        "getrlimit", "prlimit64",
        "set_tid_address", "set_robust_list",
        "futex",

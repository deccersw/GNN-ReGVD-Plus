        "exit", "exit_group",
        "wait4", "waitid",
        "clone", "fork", "vfork", "execve",
        "arch_prctl", "prctl",
        "mlock", "munlock",
        "getrandom",
        "memfd_create",
        "newfstatat",
        "rseq",
        "pread64", "pwrite64",
        "writev", "readv",
        "faccessat", "faccessat2",
        "statx",
        "close_range",
        "sigaltstack",
        "tgkill",
        "getdents64",
        "unlink", "unlinkat",
        "rename", "renameat", "renameat2",
        "mkdir", "mkdirat",
        "rmdir",
        "link", "linkat",
        "symlink", "symlinkat"
      ],
      "action": "SCMP_ACT_ALLOW"
    }
  ]
}
